@@ -0,0 +1,56 @@
+using FastDbExplorer.Domain;
+
+namespace FastDbExplorer.Application.Search;
+
+/// <summary>One page position: the OFFSET depth and, for keyset paging, the last key of the page before it.</summary>
+public sealed record PageCursor(long Offset, object?[]? AfterKey);
+
+/// <summary>
+/// Keeps the paging position of one table query: the current cursor, the stack of visited pages and the last
+/// result shown. The caller fetches the pages; the pager only decides where next and previous are.
+/// Pure: no UI, no database.
+/// </summary>
+public sealed class TablePager
+{
+    private readonly Stack<PageCursor> _history = new();
+
+    public PageCursor Current { get; private set; } = new(0, null);
+    public PageResult? LastResult { get; private set; }
+    public bool HasNext { get; private set; }
+    public bool HasPrevious => _history.Count > 0;
+
+    /// <summary>A new query starts at the first page and forgets the pages of the previous query.</summary>
+    public void Restart()
+    {
+        _history.Clear();
+        Current = new PageCursor(0, null);
+    }
+
+    /// <summary>The cursor of the next page, or null when no result has been shown yet.</summary>
+    public PageCursor? NextCursor(PageRequest baseRequest)
+    {
+        if (LastResult is null) return null;
+        var offset = Current.Offset + baseRequest.PageSize;
+        return new PageCursor(offset, PageStreamer.AfterKeyFor(baseRequest, offset, LastResult.LastKey));
+    }
+
+    /// <summary>The cursor of the previous page, or null on the first page. Does not move yet.</summary>
+    public PageCursor? PreviousCursor() => _history.Count > 0 ? _history.Peek() : null;
+
+    /// <summary>Commits a fetched next page: the current page becomes history.</summary>
+    public void Advance(PageCursor next)
+    {
+        _history.Push(Current);
+        Current = next;
+    }
+
+    /// <summary>Commits a fetched previous page: one step back through the history.</summary>
+    public void Back() => Current = _history.Pop();
+
+    /// <summary>Records the result now on screen (also after re-fetching the current page with more columns).</summary>
+    public void Record(PageResult result)
+    {
+        LastResult = result;
+        HasNext = result.HasMore;
+    }
+}
