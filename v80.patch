+++ b/tests/FastDbExplorer.Tests/TablePagerTests.cs
@@ -0,0 +1,148 @@
+using FastDbExplorer.Application.Search;
+using FastDbExplorer.Domain;
+
+namespace FastDbExplorer.Tests;
+
+public class TablePagerTests
+{
+    private static PageRequest Request(bool useKeyset = true, int pageSize = 100) => new(
+        "sales", "dbo", "orders", ["Name"], [], FilterLogic.And, ["Id"], useKeyset, pageSize, 0, null);
+
+    private static PageResult Result(bool hasMore = true, object?[]? lastKey = null) =>
+        new(["Name"], [["x"]], hasMore, lastKey);
+
+    [Fact]
+    public void A_new_pager_starts_at_the_first_page_with_no_result()
+    {
+        var pager = new TablePager();
+
+        Assert.Equal(new PageCursor(0, null), pager.Current);
+        Assert.Null(pager.LastResult);
+        Assert.False(pager.HasNext);
+        Assert.False(pager.HasPrevious);
+        Assert.Null(pager.NextCursor(Request()));
+        Assert.Null(pager.PreviousCursor());
+    }
+
+    [Fact]
+    public void Recording_a_result_updates_last_result_and_has_next()
+    {
+        var pager = new TablePager();
+        var result = Result();
+
+        pager.Record(result);
+
+        Assert.Same(result, pager.LastResult);
+        Assert.True(pager.HasNext);
+
+        pager.Record(Result(hasMore: false));
+        Assert.False(pager.HasNext);
+    }
+
+    [Fact]
+    public void The_next_cursor_advances_by_the_page_size()
+    {
+        var pager = new TablePager();
+        pager.Record(Result());
+
+        var next = pager.NextCursor(Request(pageSize: 100));
+
+        Assert.Equal(new PageCursor(100, null), next);
+    }
+
+    [Fact]
+    public void Below_the_keyset_threshold_the_next_cursor_uses_offset_only()
+    {
+        var pager = new TablePager();
+        pager.Record(Result(lastKey: new object?[] { 42 }));
+
+        var next = pager.NextCursor(Request(useKeyset: true));
+
+        Assert.Null(next!.AfterKey);
+    }
+
+    [Fact]
+    public void Past_the_keyset_threshold_the_next_cursor_carries_the_last_key()
+    {
+        var pager = new TablePager();
+        var lastKey = new object?[] { 42 };
+        pager.Record(Result(lastKey: lastKey));
+        pager.Advance(new PageCursor(PageStreamer.KeysetThreshold - 100, null));
+        pager.Record(Result(lastKey: lastKey));
+
+        var next = pager.NextCursor(Request(pageSize: 100));
+
+        Assert.Equal(PageStreamer.KeysetThreshold, next!.Offset);
+        Assert.Same(lastKey, next.AfterKey);
+    }
+
+    [Fact]
+    public void Without_keyset_paging_the_next_cursor_never_carries_a_key()
+    {
+        var pager = new TablePager();
+        pager.Record(Result(lastKey: new object?[] { 42 }));
+        pager.Advance(new PageCursor(PageStreamer.KeysetThreshold, null));
+        pager.Record(Result(lastKey: new object?[] { 42 }));
+
+        var next = pager.NextCursor(Request(useKeyset: false));
+
+        Assert.Null(next!.AfterKey);
+    }
+
+    [Fact]
+    public void Advance_then_back_walks_the_history()
+    {
+        var pager = new TablePager();
+        pager.Record(Result());
+        var first = pager.Current;
+        var second = pager.NextCursor(Request())!;
+        pager.Advance(second);
+        pager.Record(Result());
+        var third = pager.NextCursor(Request())!;
+        pager.Advance(third);
+        pager.Record(Result());
+
+        Assert.True(pager.HasPrevious);
+        Assert.Equal(third, pager.Current);
+        Assert.Equal(second, pager.PreviousCursor());
+
+        pager.Back();
+        Assert.Equal(second, pager.Current);
+        Assert.True(pager.HasPrevious);
+
+        pager.Back();
+        Assert.Equal(first, pager.Current);
+        Assert.False(pager.HasPrevious);
+        Assert.Null(pager.PreviousCursor());
+    }
+
+    [Fact]
+    public void Restart_forgets_the_history_and_returns_to_the_first_page()
+    {
+        var pager = new TablePager();
+        pager.Record(Result());
+        pager.Advance(pager.NextCursor(Request())!);
+        pager.Record(Result());
+
+        pager.Restart();
+
+        Assert.Equal(new PageCursor(0, null), pager.Current);
+        Assert.False(pager.HasPrevious);
+    }
+
+    [Fact]
+    public void Recording_a_refetched_page_keeps_the_position()
+    {
+        var pager = new TablePager();
+        pager.Record(Result());
+        pager.Advance(pager.NextCursor(Request())!);
+        pager.Record(Result());
+        var position = pager.Current;
+
+        pager.Record(Result(hasMore: false));
+
+        Assert.Equal(position, pager.Current);
+        Assert.True(pager.HasPrevious);
+        Assert.False(pager.HasNext);
+    }
+}
