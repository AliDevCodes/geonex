<UserControl x:Class="FastDbExplorer.Wpf.Views.MonitoringView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             xmlns:ctrl="clr-namespace:FastDbExplorer.Wpf.Controls"
             xmlns:vm="clr-namespace:FastDbExplorer.Wpf.ViewModels"
             xmlns:views="clr-namespace:FastDbExplorer.Wpf.Views">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type vm:MonitorEditorViewModel}"><views:MonitorEditorView /></DataTemplate>

    <!-- A small rounded tag: the interval, the last check, the live-map badge -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style x:Key="BadgeChip" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="BadgeChipText" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A section heading inside a panel: small, semibold, with room below -->
    <Style x:Key="PanelHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" /></Storyboard></BeginStoryboard></EventTrigger></Grid.Triggers>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <!-- Page header: what the page is for, and the one primary action -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{x:Static l:MonitoringStrings.Title}" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="{x:Static l:MonitoringStrings.Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{x:Static l:MonitoringStrings.NewMonitor}"
                Command="{Binding NewMonitorCommand}" VerticalAlignment="Center" Padding="18,8" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <!-- List mode: outputs (filterable) on the left, monitors on the right. Hidden while the editor is open. -->
      <Grid Margin="24,20,24,20">
        <Grid.Style>
          <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding Editor}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
          <Border.Style>
            <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
              <Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

          <!-- ============ Left: outputs (alerts), filtered by monitor and by time ============ -->
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,16,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- heading -->
                <RowDefinition Height="Auto" />  <!-- monitor -->
                <RowDefinition Height="Auto" />  <!-- quick range -->
                <RowDefinition Height="Auto" />  <!-- from -->
                <RowDefinition Height="Auto" />  <!-- to -->
                <RowDefinition Height="Auto" />  <!-- reset -->
                <RowDefinition Height="*" />     <!-- list -->
              </Grid.RowDefinitions>

              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="خروجی‌ها" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding AlertFilterSummary}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
              </Grid>

              <ComboBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding MonitorFilterChoices}" SelectedItem="{Binding SelectedMonitorFilter}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>

              <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Style="{StaticResource LinkButton}" FontSize="12" Content="همه" CommandParameter="0" Command="{Binding SetAlertRangeCommand}" Margin="0,0,12,4" />
                <Button Style="{StaticResource LinkButton}" FontSize="12" Content="امروز" CommandParameter="1" Command="{Binding SetAlertRangeCommand}" Margin="0,0,12,4" />
                <Button Style="{StaticResource LinkButton}" FontSize="12" Content="۷ روز" CommandParameter="7" Command="{Binding SetAlertRangeCommand}" Margin="0,0,12,4" />
                <Button Style="{StaticResource LinkButton}" FontSize="12" Content="۳۰ روز" CommandParameter="30" Command="{Binding SetAlertRangeCommand}" Margin="0,0,0,4" />
              </WrapPanel>

              <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="از" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <ctrl:PersianDateTimeValueBox Grid.Column="1" Value="{Binding AlertFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4" />
              </Grid>
              <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="تا" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <ctrl:PersianDateTimeValueBox Grid.Column="1" Value="{Binding AlertTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4" />
              </Grid>

              <Button Grid.Row="5" Style="{StaticResource LinkButton}" FontSize="11" HorizontalAlignment="Right" Content="پاک کردن فیلترها"
                      Command="{Binding ClearAlertFiltersCommand}" Margin="0,2,0,0" />

              <!-- The outputs themselves -->
              <Grid Grid.Row="6" Margin="0,8,0,0">
                <TextBlock Text="{Binding AlertEmptyText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding HasNoVisibleAlerts, Converter={StaticResource BoolToVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                      <Style.Triggers><DataTrigger Binding="{Binding HasNoVisibleAlerts}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                  </ScrollViewer.Style>
                  <ItemsControl ItemsSource="{Binding VisibleAlerts}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="2,8,2,10">
                          <StackPanel>
                            <TextBlock Text="{Binding MonitorName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding TimeText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                              <Button Style="{StaticResource LinkButton}" FontSize="12" Content="{x:Static l:MonitoringStrings.OpenReport}"
                                      Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                              <Button Style="{StaticResource LinkButton}" FontSize="12" Content="{x:Static l:MonitoringStrings.ShowInFolder}"
                                      Command="{Binding DataContext.ShowReportInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" FontSize="12" HorizontalAlignment="Left" Margin="0,2,0,0"
                                    Content="{x:Static l:MonitoringStrings.ShowResults}"
                                    Command="{Binding DataContext.ShowResultsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Border>

          <!-- ============ Right: monitors ============ -->
          <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,14">
              <TextBlock Text="مانیتورها" Style="{StaticResource PanelHeading}" VerticalAlignment="Center" />
              <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Monitors.Count}" Style="{StaticResource ChipText}" /></Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="{x:Static l:MonitoringStrings.NoMonitors}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"
                           Visibility="{Binding HasNoMonitors, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Monitors}" IsTabStop="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="16,14" Width="350" VerticalAlignment="Top" Margin="0,0,14,14">
                        <StackPanel>
                          <!-- Identity: icon, name, target, enable switch -->
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" Margin="0,2,12,0" VerticalAlignment="Top"
                                     Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                              <Path Data="{Binding IconShape}" Fill="{Binding IconBrush}" Stretch="Uniform" />
                            </Viewbox>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Target}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Content="{x:Static l:MonitoringStrings.Enabled}" VerticalAlignment="Top"
                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                      Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}" />
                          </Grid>

                          <!-- State: interval, last check, live map -->
                          <WrapPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding IntervalText}" Style="{StaticResource ChipText}" /></Border>
                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource ChipText}" /></Border>
                            <Border Style="{StaticResource BadgeChip}" Visibility="{Binding HasLiveMap, Converter={StaticResource BoolToVis}}">
                              <TextBlock Text="نقشه زنده" Style="{StaticResource BadgeChipText}" />
                            </Border>
                          </WrapPanel>

                          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasProblem}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                                  <DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />

                          <!-- Actions, separated from the details above -->
                          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static l:MonitoringStrings.CheckNow}" Padding="12,6"
                                        Command="{Binding DataContext.CheckNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Content="{x:Static l:MonitoringStrings.Edit}" Padding="12,6" Margin="8,0,0,0"
                                        Command="{Binding DataContext.EditMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{x:Static l:MonitoringStrings.Delete}" Padding="12,6" Foreground="{DynamicResource DangerBrush}"
                                        Command="{Binding RequestDeleteCommand}" Visibility="{Binding IsNotConfirmingDelete, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVis}}">
                                  <TextBlock Text="{x:Static l:MonitoringStrings.ConfirmDeleteQuestion}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                                  <Button Content="{x:Static l:MonitoringStrings.Yes}" Padding="12,6" Foreground="{DynamicResource DangerBrush}"
                                          Command="{Binding DataContext.DeleteMonitorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                  <Button Content="{x:Static l:MonitoringStrings.No}" Padding="12,6" Margin="6,0,0,0" Command="{Binding CancelDeleteCommand}" />
                                </StackPanel>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Static l:MonitoringStrings.RunningNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <!-- Editor mode -->
      <ContentControl Content="{Binding Editor}" IsTabStop="False" />

      <!-- Inline result preview, kept separate from Excel export and the map screen. -->
      <Border Margin="20" Padding="18" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16">
        <Border.Style>
          <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsResultPreviewVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static l:MonitoringStrings.ResultsTitle}" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="{Binding PreviewTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
              <TextBlock Text="{Binding PreviewTarget}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                         Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{x:Static l:MonitoringStrings.CloseResults}"
                    Command="{Binding CloseResultsCommand}" VerticalAlignment="Top" />
          </Grid>

          <!-- The same "show on the map" panel as the Explorer -->
          <views:MapSendPanel Grid.Row="1" Margin="0,12,0,12"
                              Columns="{Binding PreviewColumns}"
                              LatitudeColumn="{Binding LatitudeColumn, Mode=TwoWay}"
                              LongitudeColumn="{Binding LongitudeColumn, Mode=TwoWay}"
                              DetailColumns="{Binding MapDetailColumns}"
                              DetailCount="{Binding MapDetailColumnCount}"
                              SelectedCount="{Binding SelectedResultRowCount}"
                              IsSendEnabled="{Binding IsMapSendEnabled}"
                              SendCommand="{Binding SendSelectedRowsToMapCommand}" />

          <DataGrid x:Name="PreviewGrid" Grid.Row="2" ItemsSource="{Binding PreviewRows}"
                    FlowDirection="LeftToRight" SelectionMode="Extended" SelectionUnit="FullRow"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" />

          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding PreviewRowCountText}" Style="{StaticResource Muted}" />
            <TextBlock Text="{Binding PreviewStatus}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
