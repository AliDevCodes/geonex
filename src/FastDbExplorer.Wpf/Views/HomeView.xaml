<UserControl x:Class="FastDbExplorer.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             xmlns:vm="clr-namespace:FastDbExplorer.Wpf.ViewModels"
             FlowDirection="RightToLeft" FontFamily="{StaticResource AppFont}" FontSize="14"
             Foreground="{DynamicResource DashboardTextBrush}" Background="{DynamicResource DashboardBackgroundBrush}"
             UseLayoutRounding="True" Loaded="OnLoaded" Unloaded="OnUnloaded" SizeChanged="OnViewSizeChanged">
  <UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DashboardBody" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource DashboardMutedBrush}" />
    </Style>
    <Style x:Key="DashboardPanel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DashboardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DashboardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="DashboardIcon" TargetType="Path">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{DynamicResource DashboardAccentBrush}" />
      <Setter Property="StrokeThickness" Value="1.75" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="DashboardButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource DashboardTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource DashboardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DashboardOutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
      <Setter Property="ContentTemplate">
        <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextAlignment="Center" /></DataTemplate></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Margin="4" CornerRadius="8" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="FocusRing" CornerRadius="12" BorderThickness="2"
                      BorderBrush="{DynamicResource DashboardAccentBrush}" Visibility="Hidden" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource DashboardHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DashboardAccentBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource DashboardSoftBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="{DynamicResource DashboardDisabledBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource DashboardDisabledTextBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DashboardLineBrush}" />
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DashboardPrimaryButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="Background" Value="{DynamicResource DashboardPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DashboardPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DashboardOnPrimaryBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource DashboardPrimaryHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DashboardPrimaryHoverBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource DashboardPrimaryPressedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DashboardPrimaryPressedBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="{DynamicResource DashboardDisabledBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource DashboardDisabledTextBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DashboardLineBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="DashboardContent" MaxWidth="1120" Margin="32,24" SizeChanged="OnContentSizeChanged">
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{x:Static l:ShellStrings.HomeWelcome}" FontSize="26" FontWeight="Bold" />
          <TextBlock Text="{x:Static l:ShellStrings.HomeSubtitle}" Style="{StaticResource DashboardBody}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel x:Name="SessionSummary" Grid.Column="1" Margin="24,4,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding DatabasesText}" Style="{StaticResource DashboardBody}" FontSize="12" />
          <TextBlock Text="{x:Static l:Strings.ConnectedReadOnly}" Style="{StaticResource DashboardBody}" FontSize="12" />
        </StackPanel>
      </Grid>
      <Grid x:Name="WorkspaceGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ExplorerColumn" Width="62*" />
          <ColumnDefinition x:Name="PanelGap" Width="16" />
          <ColumnDefinition x:Name="SecondaryColumn" Width="38*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border x:Name="ExplorerPanel" Style="{StaticResource DashboardPanel}" CornerRadius="16" Padding="28" MinHeight="288">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource DashboardIcon}" Width="28" Height="28" Data="M3,3 L21,3 21,21 3,21 Z M3,9 L21,9 M9,9 L9,21 M3,15 L21,15" />
                <Border Width="32" Height="3" CornerRadius="1.5" Background="{DynamicResource DashboardAccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{x:Static l:ShellStrings.ExplorerTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
              <TextBlock Text="{x:Static l:ShellStrings.ExplorerTileHint}" Style="{StaticResource DashboardBody}" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
              <TextBlock Text="{x:Static l:ShellStrings.ExplorerWorkflow}" Style="{StaticResource DashboardBody}" />
              <Button Style="{StaticResource DashboardPrimaryButton}" Content="{x:Static l:ShellStrings.OpenExplorer}"
                      Command="{Binding OpenExplorerCommand}" Margin="-4,20,0,-4" KeyboardNavigation.TabIndex="0" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel x:Name="SecondaryPanels" Grid.Column="2">
          <Border Style="{StaticResource DashboardPanel}" MinHeight="136" Margin="0,0,0,16">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Path Style="{StaticResource DashboardIcon}" Data="M2,5 L8,2 16,5 22,2 22,12 M2,5 L2,21 8,18 12,20 M8,2 L8,18 M16,5 L16,10 M22,16 C22,13 16,13 16,16 C16,18 19,22 19,22 C19,22 22,18 22,16 Z M19,16 L19,16.1" />
                <TextBlock Grid.Column="1" Text="{x:Static l:ShellStrings.NavMap}" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{x:Static l:ShellStrings.MapTileHint}" Style="{StaticResource DashboardBody}" Margin="0,8,0,0" />
              <Button Style="{StaticResource DashboardButton}" Content="{x:Static l:ShellStrings.OpenMap}"
                      Command="{Binding OpenMapCommand}" Margin="-4,12,0,-4" KeyboardNavigation.TabIndex="1" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource DashboardPanel}" MinHeight="136">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Path Style="{StaticResource DashboardIcon}" Data="M3,3 L21,3 21,17 3,17 Z M8,21 L16,21 M12,17 L12,21 M5,11 L8,11 10,7 14,14 16,10 19,10" />
                <TextBlock Grid.Column="1" Text="{x:Static l:ShellStrings.NavMonitoring}" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{x:Static l:ShellStrings.MonitoringTileHint}" Style="{StaticResource DashboardBody}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding MonitorsText}" Style="{StaticResource DashboardBody}" FontSize="12" Margin="0,8,0,0" />
              <Button Style="{StaticResource DashboardButton}" Content="{x:Static l:ShellStrings.OpenMonitoring}"
                      Command="{Binding OpenMonitoringCommand}" Margin="-4,12,0,-4" KeyboardNavigation.TabIndex="2" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource DashboardPanel}" Padding="24" Margin="0,24,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{x:Static l:ShellStrings.LatestAlerts}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="AlertsAction" Grid.Column="1" Style="{StaticResource DashboardButton}" Content="{x:Static l:ShellStrings.OpenMonitoring}"
                    Command="{Binding OpenMonitoringCommand}" Margin="16,-4,-4,0" KeyboardNavigation.TabIndex="3" />
          </Grid>
          <Grid Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVis}}" Margin="0,24,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Path Style="{StaticResource DashboardIcon}" Stroke="{DynamicResource DashboardMutedBrush}" VerticalAlignment="Top" Margin="0,2,12,0"
                  Data="M5,17 C7,15 7,13 7,9 C7,2 17,2 17,9 C17,13 17,15 19,17 Z M10,21 C11,22 13,22 14,21 M12,2 L12,3" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{x:Static l:ShellStrings.NoAlertsYet}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding EmptyAlertsHint}" Style="{StaticResource DashboardBody}" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding RecentAlerts}" IsTabStop="False" Margin="0,10,0,0" AlternationCount="5">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="0,14" BorderBrush="{DynamicResource DashboardLineBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderThickness" Value="0,1,0,0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                          <Setter Property="BorderThickness" Value="0" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Path x:Name="AlertIcon" Style="{StaticResource DashboardIcon}" VerticalAlignment="Top" Margin="0,2,12,0"
                          Data="M5,17 C7,15 7,13 7,9 C7,2 17,2 17,9 C17,13 17,15 19,17 Z M10,21 C11,22 13,22 14,21 M12,2 L12,3" />
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="AlertLabel" Text="{x:Static l:ShellStrings.AlertMatch}" FontSize="12" Foreground="{DynamicResource DashboardMutedBrush}" />
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource DashboardBody}" Margin="0,4,0,0" />
                      <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding TimeText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="12" Foreground="{DynamicResource DashboardMutedBrush}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:AlertKind.CheckFailed}">
                    <Setter TargetName="AlertLabel" Property="Text" Value="{x:Static l:ShellStrings.AlertCheckFailed}" />
                    <Setter TargetName="AlertIcon" Property="Stroke" Value="{DynamicResource DashboardDangerBrush}" />
                    <Setter TargetName="AlertIcon" Property="Data" Value="M12,2 L23,22 1,22 Z M12,9 L12,15 M12,18 L12,18.1" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
