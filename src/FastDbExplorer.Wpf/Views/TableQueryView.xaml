<UserControl x:Class="FastDbExplorer.Wpf.Views.TableQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FastDbExplorer.Wpf.Localization"
             xmlns:ctrl="clr-namespace:FastDbExplorer.Wpf.Controls"
             xmlns:views="clr-namespace:FastDbExplorer.Wpf.Views">
  <UserControl.Resources>
    <Style TargetType="ToolTip">
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="MaxHeight" Value="360" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FlowDirection="LeftToRight" />
            </ScrollViewer>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="TextFilterValueTemplate">
      <TextBox FlowDirection="LeftToRight" Padding="10,8" ToolTip="{x:Static l:Strings.ValueTip}"
               Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
    <DataTemplate x:Key="DateTimeFilterValueTemplate">
      <ctrl:PersianDateTimeValueBox Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{x:Static l:Strings.ValueTip}" />
    </DataTemplate>
    <DataTemplate x:Key="TextFilterValue2Template">
      <TextBox FlowDirection="LeftToRight" Padding="10,8" Width="110" ToolTip="{x:Static l:Strings.Value2Tip}"
               Text="{Binding Value2, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
    <DataTemplate x:Key="DateTimeFilterValue2Template">
      <ctrl:PersianDateTimeValueBox Width="130" Value="{Binding Value2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{x:Static l:Strings.Value2Tip}" />
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: table name and the active conditions; actions on the other side -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding TableName}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="22"
                   FontWeight="Bold" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock Text="{x:Static l:Strings.ApproxRows}" Style="{StaticResource Muted}" />
          <TextBlock Text="{Binding ApproxRows, StringFormat={}{0:N0}}" Style="{StaticResource Muted}" Margin="6,0,0,0" />
          <!-- Chips: the nearby point and the filters that are still applied -->
          <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
            <Border.Style>
              <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.SearchPointText, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                       Text="{Binding DataContext.SearchPointText, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}}" />
          </Border>
          <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
            <Border.Style>
              <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Filters.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                       Text="{Binding Filters.Count, StringFormat={x:Static l:ExportStrings.ActiveFiltersFormat}}" />
          </Border>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{x:Static l:Strings.ToggleSettings}" Command="{Binding ToggleConfigCommand}" />
        <!-- Run and Cancel always sit side by side: Run is disabled while a query runs, Cancel is enabled only then (also Esc). -->
        <Button Content="{x:Static l:Strings.Run}" Command="{Binding RunCommand}" Margin="8,0,0,0" MinWidth="110"
                Style="{StaticResource PrimaryButton}" />
        <Button Content="{x:Static l:Strings.Cancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0" MinWidth="110"
                ToolTip="لغو اجرا (Esc)" />
        <TextBlock Text="در حال اجرا…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <Button Content="{x:Static l:Strings.ExportExcel}" Command="{Binding ExportExcelCommand}" Margin="8,0,0,0" />
      </StackPanel>
    </Grid>

    <!-- Settings: columns on the side; the search area (point + filters) on the other -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" CornerRadius="14" Margin="0,0,0,12"
            Visibility="{Binding IsConfigVisible, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="210" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Column selector -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static l:Strings.Columns}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Style="{StaticResource LinkButton}" Content="{x:Static l:Strings.SelectAll}" Command="{Binding SelectAllColumnsCommand}" />
              <Button Style="{StaticResource LinkButton}" Content="{x:Static l:Strings.SelectNone}" Command="{Binding SelectNoColumnsCommand}" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight">
            <ItemsControl ItemsSource="{Binding Columns}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding TypeName}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                      <TextBlock Text="PK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsKey, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Width="1" Margin="16,0" Background="{DynamicResource LineBrush}" />

        <StackPanel Grid.Column="2">
          <!-- Nearby point: labelled fields, one apply, one clear. Errors sit under the fields. -->
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="نزدیک نقطه" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="عرض جغرافیایی" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Width="140" Height="30" Padding="8,3" FontSize="12" FlowDirection="LeftToRight" VerticalContentAlignment="Center" ToolTip="مثلاً 35.6892"
                         Text="{Binding DataContext.SearchLatitudeText, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="طول جغرافیایی" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Width="140" Height="30" Padding="8,3" FontSize="12" FlowDirection="LeftToRight" VerticalContentAlignment="Center" ToolTip="مثلاً 51.3890"
                         Text="{Binding DataContext.SearchLongitudeText, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="شعاع (متر)" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
                <TextBox Width="110" Height="30" Padding="8,3" FontSize="12" FlowDirection="LeftToRight" VerticalContentAlignment="Center" ToolTip="فاصله‌ی مجاز از نقطه، بر حسب متر"
                         Text="{Binding DataContext.SearchRadiusText, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource PrimaryButton}" Content="اعمال" Height="30" Padding="16,0"
                        Command="{Binding DataContext.ApplyManualPointCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}}" />
                <Button Style="{StaticResource LinkButton}" Content="حذف" Margin="8,0,0,0" Height="30"
                        Command="{Binding DataContext.ClearSearchPointCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding DataContext.SearchError, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers><DataTrigger Binding="{Binding DataContext.SearchError, RelativeSource={RelativeSource AncestorType={x:Type views:ExplorerView}}}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <!-- Filters -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static l:Strings.Filters}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Border Grid.Column="1" HorizontalAlignment="Left" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="3">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="logic" Content="{x:Static l:Strings.MatchAll}" FontSize="12" IsChecked="{Binding MatchAll}" />
                <RadioButton Style="{StaticResource SegmentButton}" GroupName="logic" Content="{x:Static l:Strings.MatchAny}" FontSize="12" IsChecked="{Binding UseOr}" />
              </StackPanel>
            </Border>
            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="{x:Static l:Strings.AddFilter}" Command="{Binding AddFilterCommand}" />
          </Grid>

          <!-- Saved filters: name, save, reuse and delete the current conditions for this table -->
          <!-- Saved filters for this table: a chip applies one, × deletes it, the line below saves the current conditions. -->
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="فیلترهای ذخیره‌شده" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding SavedFilters.Items}" IsTabStop="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" Padding="10,3,4,3" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource LinkButton}" Content="{Binding Name}" Foreground="{DynamicResource AccentBrush}" Padding="0"
                              ToolTip="اعمال این فیلتر"
                              Command="{Binding DataContext.ApplySavedFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource LinkButton}" Content="&#215;" Foreground="{DynamicResource MutedBrush}" Padding="6,0,4,0"
                              ToolTip="حذف این فیلتر"
                              Command="{Binding DataContext.DeleteSavedFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="هنوز فیلتری برای این جدول ذخیره نشده است." FontSize="12" Margin="0,0,0,6">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SavedFilters.Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBox Width="200" Text="{Binding SavedFilters.Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="نام فیلتر فعلی" />
              <Button Style="{StaticResource LinkButton}" Content="ذخیرهٔ شرط‌های فعلی" Command="{Binding SaveFilterCommand}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding SavedFilters.Status}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SavedFilters.Status}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Filters}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Column picker -->
                    <ComboBox FlowDirection="LeftToRight" Margin="0,0,8,0"
                              ItemsSource="{Binding DataContext.FilterableColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding Column}" />

                    <!-- Operator picker -->
                    <ComboBox Grid.Column="1" Margin="0,0,8,0"
                              ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding SelectedOperator}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--
                      Value field — adapts to the column type:
                      • DateTime column  → Persian Solar Hijri calendar + time picker
                      • Everything else  → plain TextBox
                      Both bind to FilterRowViewModel.Value.
                    -->
                    <Grid Grid.Column="2" Visibility="{Binding NeedsValue, Converter={StaticResource BoolToVis}}">
                      <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ContentControl.Style>
                          <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource TextFilterValueTemplate}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDateTimeField}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource DateTimeFilterValueTemplate}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ContentControl.Style>
                      </ContentControl>
                    </Grid>

                    <!-- Second value (Between operator) — same pattern -->
                    <Grid Grid.Column="3" Margin="8,0,0,0"
                          Visibility="{Binding NeedsSecondValue, Converter={StaticResource BoolToVis}}">
                      <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ContentControl.Style>
                          <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource TextFilterValue2Template}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDateTimeField}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource DateTimeFilterValue2Template}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ContentControl.Style>
                      </ContentControl>
                    </Grid>

                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="4,0,0,0"
                            Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Order by -->
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{x:Static l:Strings.OrderBy}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding UsesPrimaryKey, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="{x:Static l:Strings.OrderByKey}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding KeyDescription}" FlowDirection="LeftToRight" FontWeight="SemiBold" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding NeedsOrderColumn, Converter={StaticResource BoolToVis}}">
              <ComboBox MinWidth="200" FlowDirection="LeftToRight" ItemsSource="{Binding FilterableColumns}" SelectedItem="{Binding OrderColumn}" />
              <TextBlock Text="{x:Static l:Strings.PickOrderColumn}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Error -->
    <Border Grid.Row="2" Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
      <Border.Style>
        <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
          <Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
    </Border>

    <!-- Results: a compact map toolbar, then the table takes all the remaining room -->
    <Grid Grid.Row="3">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

          <!-- The same "show on the map" panel as Monitoring -->
          <views:MapSendPanel Grid.Row="0" Margin="8,8,8,6"
                              Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                              Columns="{Binding CoordinateColumns}"
                              LatitudeColumn="{Binding LatitudeColumn, Mode=TwoWay}"
                              LongitudeColumn="{Binding LongitudeColumn, Mode=TwoWay}"
                              DetailColumns="{Binding MapDetailColumns}"
                              DetailCount="{Binding MapDetailColumnCount}"
                              SelectedCount="{Binding SelectedRowCount}"
                              SendCommand="{Binding ShowSelectedOnMapCommand}" />

          <DataGrid x:Name="ResultGrid" Grid.Row="1" FlowDirection="LeftToRight" ItemsSource="{Binding Rows}"
                    SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ResultGrid_SelectionChanged"
                    MouseDoubleClick="ResultGrid_MouseDoubleClick"
                    ToolTip="برای مشاهده مقدار کامل، روی یک سلول دوبار کلیک کنید."
                    AutomationProperties.HelpText="برای مشاهده مقدار کامل، روی یک سلول دوبار کلیک کنید."
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Border>
      <TextBlock Text="{x:Static l:Strings.ResultHint}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Visible" />
            <Style.Triggers><DataTrigger Binding="{Binding HasResult}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Margin="12,0"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </Grid>

    <!-- Pager (unchanged) -->
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="{x:Static l:Strings.Previous}" Command="{Binding PreviousCommand}" />
        <Button Content="{x:Static l:Strings.Next}" Command="{Binding NextCommand}" Margin="8,0,0,0" />
        <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"
                   TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding PageInfo}" />
        <TextBlock Text="{Binding ResultCountText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
        <Button Content="{x:Static l:Strings.SendAllToMap}" Command="{Binding ShowAllOnMapCommand}" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="{x:Static l:Strings.PageSizeLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Width="90" FlowDirection="LeftToRight" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
